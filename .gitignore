## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ins.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017 cache/options directory
.vs/

# Mac
.DS_Store

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Coverlet / Coverage
coverage.cobertura.xml
TestResults/
coveragereport/

# IDE / Editors
.idea/
.vscode/

# Python
*.pyc
__pycache__/

# AI Agent Files
AGENT_INSTRUCTIONS.md
AI_GUIDELINES.md
scratch/
