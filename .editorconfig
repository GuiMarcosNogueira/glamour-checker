root = true

[*.cs]
# Define o estilo de formatação do dotnet format como restrito (erro de build)
dotnet_diagnostic.IDE0055.severity = error

# Configurações básicas de estilo para C#
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
