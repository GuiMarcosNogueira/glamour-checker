<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <Name>GlamourChecker</Name>
        <Author>Dr. Marcos</Author>
        <Punchline>Never throw away an appearance you don't have yet!</Punchline>
        <Description>Checks your inventory and alerts you about equipment whose models (appearances) haven't been stored in the Glamour Dresser or Armoire yet.</Description>
        <RepoUrl>https://github.com/GuiMarcosNogueira/glamour-checker</RepoUrl>
        <Tags>glamour,inventory,utility</Tags>
        <IconUrl>https://raw.githubusercontent.com/GuiMarcosNogueira/glamour-checker/main/images/icon.png</IconUrl>
    </PropertyGroup>

  <ItemGroup>
    <None Include="loc\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Resources\SharedModels.json" />
  </ItemGroup>
</Project>

