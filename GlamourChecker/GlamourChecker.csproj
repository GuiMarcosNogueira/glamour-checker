<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Name>GlamourChecker</Name>
        <Author>Illidan</Author>
        <Punchline>Nunca mais jogue fora uma aparencia que voce nao tem!</Punchline>
        <Description>Verifica seu inventario e alerta sobre equipamentos cujos modelos (aparências) ainda não foram guardados no Glamour Dresser ou Armoire.</Description>
        <RepoUrl>https://github.com/GuiMarcosNogueira/glamour-checker</RepoUrl>
        <Tags>glamour,inventory,utility</Tags>
        <IconUrl>https://raw.githubusercontent.com/GuiMarcosNogueira/glamour-checker/main/images/icon.png</IconUrl>
    </PropertyGroup>

  <ItemGroup>
    <None Include="loc\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
